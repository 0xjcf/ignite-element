# >>> FAS managed ignore block >>>
# FAS runtime data and local workspace state (generated, do not commit)
.fas/*
# Track the queue contract so durable epics and dependency edges survive clean
# checkouts; keep queue backups and other runtime artifacts ignored.
!.fas/queue/
.fas/queue/*
!.fas/queue/tasks.json
# Local FAS memory is generated/operational state — keep it untracked. (It is
# covered by `.fas/*` above; do not re-add `!.fas/memory/` negations.)
!.fas/TASKS.md
!.fas/architecture-rules.json
!.fas/workspace-dependencies.json
!.fas/tasks/
.fas/tasks/*
!.fas/tasks/*.md
.codex/
.claude/
.mcp.json
fas
# <<< FAS managed ignore block <<<

