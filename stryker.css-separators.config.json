{
	"$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-schema.json",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"vitest": {
		"configFile": "packages/ignite-element/vitest.stryker.xss.config.ts",
		"dir": "packages/ignite-element",
		"related": false
	},
	"mutate": [
		"packages/ignite-renderer/src/renderers/jsx/xssGuard.ts:185-246",
		"packages/ignite-renderer/src/renderers/jsx/xssGuard.ts:263-324",
		"packages/ignite-renderer/src/renderers/jsx/xssGuard.ts:376-386"
	],
	"coverageAnalysis": "off",
	"incremental": false,
	"reporters": ["clear-text", "json"],
	"jsonReporter": { "fileName": "reports/mutation/css-separators.json" },
	"thresholds": { "high": 85, "low": 80, "break": 80 },
	"concurrency": 4,
	"timeoutMS": 15000
}
