{
	"extends": "../../../../tsconfig.typecheck.json",
	"compilerOptions": {
		"noEmit": true,
		"composite": false,
		"jsx": "react-jsx",
		"jsxImportSource": "ignite-element/jsx",
		"allowJs": false,
		"paths": {
			"ignite-element": ["../../../index.ts"],
			"ignite-element/jsx": ["../../../jsx/index.ts"],
			"ignite-element/jsx/jsx-runtime": ["../../../jsx/jsx-runtime.ts"],
			"ignite-element/jsx/jsx-dev-runtime": ["../../../jsx/jsx-dev-runtime.ts"],
			"ignite-element/*": ["../../../*"],
			"@ignite-element/core": ["../../../../../ignite-core/src/index.ts"],
			"@ignite-element/adapters": [
				"../../../../../ignite-adapters/src/index.ts"
			],
			"@ignite-element/adapters/xstate": [
				"../../../../../ignite-adapters/src/xstate.ts"
			],
			"@ignite-element/adapters/redux": [
				"../../../../../ignite-adapters/src/redux.ts"
			],
			"@ignite-element/adapters/mobx": [
				"../../../../../ignite-adapters/src/mobx.ts"
			],
			"@ignite-element/renderer": [
				"../../../../../ignite-renderer/src/index.ts"
			],
			"@ignite-element/renderer/jsx": [
				"../../../../../ignite-renderer/src/renderers/ignite-jsx.ts"
			],
			"@ignite-element/renderer/lit": [
				"../../../../../ignite-renderer/src/renderers/lit.ts"
			],
			"@ignite-element/renderer/jsx-runtime": [
				"../../../../../ignite-renderer/src/jsx/jsx-runtime.ts"
			],
			"@ignite-element/renderer/jsx-dev-runtime": [
				"../../../../../ignite-renderer/src/jsx/jsx-dev-runtime.ts"
			],
			"@ignite-element/renderer/jsx/index": [
				"../../../../../ignite-renderer/src/jsx/index.ts"
			]
		}
	},
	"include": ["./**/*.ts", "./**/*.tsx"],
	"exclude": []
}
