	"description": "Default public package for building state-driven Web Components with Ignite.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xjcf/ignite-element.git"
	},
	"homepage": "https://github.com/0xjcf/ignite-element#readme",
	"bugs": {
		"url": "https://github.com/0xjcf/ignite-element/issues"
	},
	"keywords": [
		"web-components",
		"state-management",
		"redux",
		"xstate",
		"mobx",
		"actor-web",
		"ignite-element"
	],
	"author": "Jose C. Flores (0xjcf)",
	"license": "MIT",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"./src/renderers/*.ts",
		"./src/renderers/*.js",
		"./dist/registry-*.js",
		"./dist/jsx.es-*.js",
		"./dist/renderers/*.es.js",
		"./dist/projectionTargets-*.js",
		"./dist/IgniteElement-*.js"
	],
	"scripts": {
		"build:types": "tsc && node ../../scripts/rewrite-declaration-extensions.mjs .",
		"build:js": "vite build && IGNITE_LIB_DEV=1 vite build && node ../../scripts/rewrite-declaration-extensions.mjs .",
		"verify:exports": "node ./scripts/verify-exports.mjs",
		"build": "pnpm run build:types && pnpm run build:js && node ../../scripts/published-host-declarations.mjs && pnpm run verify:exports",
		"docs:dev": "pnpm --filter docs-site dev",
		"docs:build": "pnpm --filter docs-site build",
		"docs:preview": "pnpm --filter docs-site preview",
		"examples:xstate": "cd ../../examples/adapters/xstate && pnpm install --ignore-workspace --no-link-workspace-packages && pnpm run build:css && pnpm run dev",
		"examples:redux": "cd ../../examples/adapters/redux && pnpm install --ignore-workspace --no-link-workspace-packages && pnpm run dev",
		"examples:mobx": "cd ../../examples/adapters/mobx && pnpm install --ignore-workspace --no-link-workspace-packages && pnpm run dev",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:node": "FORCE_COLOR=1 vitest --config vitest.node.config.ts --run",
		"typecheck": "pnpm exec tsc --noEmit --pretty false --project tsconfig.typecheck.json && pnpm exec tsc --project src/tests/tsconfig.json && pnpm exec tsc --project src/tests/types/radio-host/tsconfig.json && pnpm exec tsc --project tests/tsconfig.json",
		"format": "biome format --write .",
		"check": "biome check .",
		"lint": "biome lint .",
		"prepare": "husky"
	},
	"dependencies": {
		"@ignite-element/core": "workspace:*",
		"@ignite-element/renderer": "workspace:*",
		"@ignite-element/adapters": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.1",
		"@changesets/cli": "^2.29.8",
		"@commitlint/cli": "^20.2.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@playwright/test": "^1.56.1",
		"@reduxjs/toolkit": "^2.12.0",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "^16.1.0",
		"@types/jsdom": "^27.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitest/coverage-v8": "^4.0.3",
		"chalk": "^5.6.2",
		"husky": "^9.1.7",
		"jsdom": "^27.0.1",
		"mobx": "^6.16.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.12",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.0.3",
		"xstate": "^5.32.1"
	},
	"peerDependencies": {
		"@reduxjs/toolkit": ">=2.3.0",
		"lit-html": ">=3.2.1",
		"mobx": ">=6.13.5",
		"react": ">=18",
		"redux": ">=5.0.1",
