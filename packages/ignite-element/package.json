{
	"name": "ignite-element",
	"version": "3.0.0-beta.4",
	"type": "module",
	"main": "dist/ignite-element.cjs.js",
	"types": "dist/types/index.d.ts",
	"module": "dist/ignite-element.es.js",
	"typesVersions": {
		"*": {
			"xstate": [
				"dist/types/xstate.d.ts"
			],
			"redux": [
				"dist/types/redux.d.ts"
			],
			"mobx": [
				"dist/types/mobx.d.ts"
			],
			"actor-web": [
				"dist/types/actor-web.d.ts"
			],
			"jsx": [
				"dist/types/jsx/index.d.ts"
			],
			"jsx/jsx-runtime": [
				"dist/types/jsx/jsx-runtime.d.ts"
			],
			"jsx/jsx-dev-runtime": [
				"dist/types/jsx/jsx-dev-runtime.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/ignite-element.es.js",
			"require": "./dist/ignite-element.cjs.js",
			"default": "./dist/ignite-element.es.js"
		},
		"./xstate": {
			"types": "./dist/types/xstate.d.ts",
			"import": "./dist/xstate.es.js",
			"require": "./dist/xstate.cjs.js",
			"default": "./dist/xstate.es.js"
		},
		"./redux": {
			"types": "./dist/types/redux.d.ts",
			"import": "./dist/redux.es.js",
			"require": "./dist/redux.cjs.js",
			"default": "./dist/redux.es.js"
		},
		"./mobx": {
			"types": "./dist/types/mobx.d.ts",
			"import": "./dist/mobx.es.js",
			"require": "./dist/mobx.cjs.js",
			"default": "./dist/mobx.es.js"
		},
		"./actor-web": {
			"types": "./dist/types/actor-web.d.ts",
			"import": "./dist/actor-web.es.js",
			"require": "./dist/actor-web.cjs.js",
			"default": "./dist/actor-web.es.js"
		},
		"./jsx": {
			"types": "./dist/types/jsx/index.d.ts",
			"import": "./dist/jsx/index.es.js",
			"require": "./dist/jsx/index.cjs.js",
			"default": "./dist/jsx/index.es.js"
		},
		"./jsx/jsx-runtime": {
			"types": "./dist/types/jsx/jsx-runtime.d.ts",
			"import": "./dist/jsx/jsx-runtime.es.js",
			"require": "./dist/jsx/jsx-runtime.cjs.js",
			"default": "./dist/jsx/jsx-runtime.es.js"
		},
		"./jsx/jsx-dev-runtime": {
			"types": "./dist/types/jsx/jsx-dev-runtime.d.ts",
			"import": "./dist/jsx/jsx-dev-runtime.es.js",
			"require": "./dist/jsx/jsx-dev-runtime.cjs.js",
			"default": "./dist/jsx/jsx-dev-runtime.es.js"
		},
		"./package.json": "./package.json"
	},
	"description": "Default public package for building state-driven Web Components with Ignite.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xjcf/ignite-element.git"
	},
	"homepage": "https://github.com/0xjcf/ignite-element#readme",
	"bugs": {
		"url": "https://github.com/0xjcf/ignite-element/issues"
	},
	"keywords": [
		"web-components",
		"state-management",
		"redux",
		"xstate",
		"mobx",
		"actor-web",
		"ignite-element"
	],
	"author": "Jose C. Flores (0xjcf)",
	"license": "MIT",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"./src/internal/setupDomPolyfill.ts",
		"./dist/testing-*.js",
		"./dist/testing-*.cjs"
	],
	"scripts": {
		"build:types": "tsc",
		"build:js": "vite build",
		"verify:exports": "node ./scripts/verify-exports.mjs",
		"build": "pnpm run build:types && pnpm run build:js && pnpm run verify:exports",
		"docs:dev": "pnpm --filter docs-site dev",
		"docs:build": "pnpm --filter docs-site build",
		"docs:preview": "pnpm --filter docs-site preview",
		"examples:xstate": "cd src/examples/xstate && pnpm install --ignore-workspace --no-link-workspace-packages && pnpm run build:css && pnpm run dev",
		"examples:redux": "cd src/examples/redux && pnpm install --ignore-workspace --no-link-workspace-packages && pnpm run dev",
		"examples:mobx": "cd src/examples/mobx && pnpm install --ignore-workspace --no-link-workspace-packages && pnpm run dev",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:node": "FORCE_COLOR=1 vitest --config vitest.node.config.ts --run",
		"typecheck": "pnpm exec tsc --noEmit --pretty false --project tsconfig.typecheck.json && pnpm exec tsc --project src/examples/xstate/tsconfig.json && pnpm exec tsc --project src/examples/redux/tsconfig.json && pnpm exec tsc --project src/examples/spa-router/tsconfig.json && pnpm exec tsc --project src/tests/tsconfig.json",
		"format": "biome format --write .",
		"check": "biome check .",
		"lint": "biome lint .",
		"release": "changeset publish",
		"postrelease": "pnpm publish",
		"prepare": "husky"
	},
	"dependencies": {
		"@ignite-element/core": "workspace:*",
		"@ignite-element/renderer": "workspace:*",
		"@ignite-element/adapters": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.1",
		"@changesets/cli": "^2.29.8",
		"@commitlint/cli": "^20.2.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@playwright/test": "^1.56.1",
		"@types/jsdom": "^27.0.0",
		"@vitest/coverage-v8": "^4.0.3",
		"chalk": "^5.6.2",
		"husky": "^9.1.7",
		"jsdom": "^27.0.1",
		"typescript": "^5.9.3",
		"vite": "^7.1.12",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.0.3",
		"xstate": "^5.23.0"
	},
	"peerDependencies": {
		"@reduxjs/toolkit": ">=2.3.0",
		"lit-html": ">=3.2.1",
		"mobx": ">=6.13.5",
		"redux": ">=5.0.1",
		"xstate": ">=5.19.0"
	},
	"peerDependenciesMeta": {
		"@reduxjs/toolkit": {
			"optional": true
		},
		"lit-html": {
			"optional": true
		},
		"mobx": {
			"optional": true
		},
		"redux": {
			"optional": true
		},
		"xstate": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	}
}
