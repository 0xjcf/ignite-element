{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "..",
		"paths": {
			"ignite-element": ["./src/index.ts"],
			"ignite-element/*": ["./src/*"],
			"@ignite-element/core": ["../ignite-core/src/index.ts"],
			"@ignite-element/adapters": ["../ignite-adapters/src/index.ts"],
			"@ignite-element/adapters/actor-web": [
				"../ignite-adapters/src/actor-web.ts"
			],
			"@ignite-element/adapters/xstate": ["../ignite-adapters/src/xstate.ts"],
			"@ignite-element/adapters/redux": ["../ignite-adapters/src/redux.ts"],
			"@ignite-element/adapters/mobx": ["../ignite-adapters/src/mobx.ts"],
			"@ignite-element/renderer": ["../ignite-renderer/src/index.ts"],
			"@ignite-element/renderer/jsx": [
				"../ignite-renderer/src/renderers/ignite-jsx.ts"
			],
			"@ignite-element/renderer/lit": [
				"../ignite-renderer/src/renderers/lit.ts"
			],
			"@ignite-element/renderer/jsx-runtime": [
				"../ignite-renderer/src/jsx/jsx-runtime.ts"
			],
			"@ignite-element/renderer/jsx-dev-runtime": [
				"../ignite-renderer/src/jsx/jsx-dev-runtime.ts"
			],
			"@ignite-element/renderer/jsx/index": [
				"../ignite-renderer/src/jsx/index.ts"
			],
			"ignite-element/actor-web": ["./src/actor-web.ts"],
			"ignite-element/renderers/ignite-jsx": ["./src/renderers/ignite-jsx.ts"],
			"ignite-element/renderers/lit": ["./src/renderers/lit.ts"],
			"ignite-element/config/vite": ["./src/config/vite.ts"],
			"ignite-element/config/webpack": ["./src/config/webpack.ts"],
			"ignite-element/config/loadIgniteConfig": [
				"./src/config/loadIgniteConfig.ts"
			],
			"ignite-element/jsx": ["./src/jsx/index.ts"],
			"xstate": ["./node_modules/xstate"],
			"xstate/*": ["./node_modules/xstate/*"]
		}
	},
	"include": [
		"src",
		"../ignite-core/src",
		"../ignite-adapters/src",
		"../ignite-renderer/src"
	]
}
