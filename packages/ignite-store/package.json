{
	"name": "ignite-store",
	"version": "2.2.2",
	"type": "module",
	"main": "dist/ignite-store.cjs.js",
	"module": "dist/ignite-store.es.js",
	"types": "dist/types/index.d.ts",
	"description": "Compatibility re-export package for the move from ignite-store to ignite-adapters.",
	"typesVersions": {
		"*": {
			"redux": [
				"dist/types/redux.d.ts"
			],
			"mobx": [
				"dist/types/mobx.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/ignite-store.es.js",
			"require": "./dist/ignite-store.cjs.js",
			"default": "./dist/ignite-store.es.js"
		},
		"./redux": {
			"types": "./dist/types/redux.d.ts",
			"import": "./dist/redux.es.js",
			"require": "./dist/redux.cjs.js",
			"default": "./dist/redux.es.js"
		},
		"./mobx": {
			"types": "./dist/types/mobx.d.ts",
			"import": "./dist/mobx.es.js",
			"require": "./dist/mobx.cjs.js",
			"default": "./dist/mobx.es.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build:types": "tsc",
		"build:js": "vite build",
		"build": "pnpm run build:types && pnpm run build:js",
		"typecheck": "tsc --noEmit --pretty false --project tsconfig.json"
	},
	"dependencies": {
		"ignite-adapters": "workspace:*"
	},
	"peerDependencies": {
		"@reduxjs/toolkit": ">=2.3.0",
		"mobx": ">=6.13.5",
		"redux": ">=5.0.1"
	},
	"devDependencies": {
		"@reduxjs/toolkit": "^2.3.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.12",
		"vite-plugin-dts": "^4.5.4"
	}
}
