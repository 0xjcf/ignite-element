{
	"name": "ignite-core",
	"version": "2.2.2",
	"type": "module",
	"main": "dist/ignite-core.cjs.js",
	"module": "dist/ignite-core.es.js",
	"types": "dist/types/index.d.ts",
	"typesVersions": {
		"*": {
			"xstate": [
				"dist/types/xstate.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/ignite-core.es.js",
			"require": "./dist/ignite-core.cjs.js",
			"default": "./dist/ignite-core.es.js"
		},
		"./xstate": {
			"types": "./dist/types/xstate.d.ts",
			"import": "./dist/xstate.es.js",
			"require": "./dist/xstate.cjs.js",
			"default": "./dist/xstate.es.js"
		}
	},
	"sideEffects": false,
	"scripts": {
		"build:types": "tsc",
		"build:js": "vite build",
		"build": "pnpm run build:types && pnpm run build:js",
		"typecheck": "tsc --noEmit --pretty false --project tsconfig.json"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"vite": "^7.1.12",
		"vite-plugin-dts": "^4.5.4"
	},
	"peerDependencies": {
		"xstate": ">=5.19.0"
	}
}
