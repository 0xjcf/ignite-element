{
	"name": "ignite-core",
	"version": "3.0.0-beta.1",
	"type": "module",
	"main": "dist/ignite-core.cjs.js",
	"module": "dist/ignite-core.es.js",
	"types": "dist/types/index.d.ts",
	"description": "Adapter-neutral primitives for the ignite-element package family, versioned in lockstep with ignite-element.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xjcf/ignite-element.git"
	},
	"homepage": "https://github.com/0xjcf/ignite-element#readme",
	"bugs": {
		"url": "https://github.com/0xjcf/ignite-element/issues"
	},
	"keywords": [
		"ignite-element",
		"web-components",
		"state-management",
		"runtime"
	],
	"author": "Jose C. Flores (0xjcf)",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/ignite-core.es.js",
			"require": "./dist/ignite-core.cjs.js",
			"default": "./dist/ignite-core.es.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build:types": "tsc",
		"build:js": "vite build",
		"build": "pnpm run build:types && pnpm run build:js",
		"typecheck": "tsc --noEmit --pretty false --project tsconfig.json"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"vite": "^7.1.12",
		"vite-plugin-dts": "^4.5.4"
	}
}
