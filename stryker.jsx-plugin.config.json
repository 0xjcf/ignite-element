{
	"$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-schema.json",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"vitest": {
		"configFile": "packages/jsx-plugin/vitest.stryker.config.ts",
		"dir": "packages/jsx-plugin",
		"related": false
	},
	"mutate": ["packages/jsx-plugin/src/transform.ts"],
	"coverageAnalysis": "perTest",
	"incremental": false,
	"reporters": ["clear-text", "json"],
	"jsonReporter": { "fileName": "reports/mutation/jsx-plugin.json" },
	"thresholds": { "high": 85, "low": 80, "break": 80 },
	"concurrency": 4,
	"timeoutMS": 15000,
	"ignoreStatic": true
}
