{
	"name": "ignite-workspace",
	"private": true,
	"scripts": {
		"build": "pnpm -r run build",
		"build:types": "pnpm -r run build:types",
		"build:js": "pnpm -r run build:js",
		"test": "pnpm run test:full",
		"test:packages": "pnpm --filter ignite-element test",
		"test:scripts": "node --test scripts/__tests__/*.test.mjs",
		"test:examples": "node scripts/test-examples.mjs",
		"test:full": "pnpm run test:packages && pnpm run test:scripts && pnpm run test:examples -- --require-covered-packages-match-discovered --covers-package examples/adapters/mobx --covers-package examples/adapters/redux --covers-package examples/adapters/xstate --covers-package examples/agents/smart-home --covers-package examples/agents/voice-workbench --covers-package examples/apps/dashboard-with-shared-state --covers-package examples/apps/form-with-validation --covers-package examples/apps/nested-child-router --covers-package examples/apps/spa-router",
		"test:coverage": "pnpm --filter ignite-element test:coverage",
		"test:node": "pnpm --filter ignite-element test:node",
		"typecheck": "pnpm run typecheck:full",
		"typecheck:packages": "pnpm -r run typecheck",
		"typecheck:examples": "node scripts/typecheck-examples.mjs",
		"typecheck:full": "pnpm run typecheck:packages && pnpm run typecheck:examples",
		"format": "biome format --write . && pnpm run format:md",
		"format:check": "biome format . && pnpm run lint:md",
		"format:md": "markdownlint-cli2 --fix",
		"check": "biome check . && pnpm run lint:md",
		"lint": "biome lint . && pnpm run lint:md",
		"lint:md": "markdownlint-cli2",
		"architecture:check": "node scripts/check-architecture-rules.mjs",
		"size:entrypoints": "pnpm --filter ignite-element... build && node scripts/measure-bundle-sizes.mjs",
		"docs:dev": "pnpm --filter docs-site dev",
		"docs:build": "pnpm --filter docs-site build",
		"docs:preview": "pnpm --filter docs-site preview",
		"example:voice-workbench": "pnpm --dir examples/agents/voice-workbench dev:mlx",
		"examples:xstate": "pnpm --filter ignite-element examples:xstate",
		"examples:redux": "pnpm --filter ignite-element examples:redux",
		"examples:mobx": "pnpm --filter ignite-element examples:mobx",
		"migrate:effects-events": "node scripts/migrate-emit-to-effects.mjs",
		"changeset": "changeset",
		"release:beta": "node scripts/release-beta.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.1",
		"@changesets/cli": "^2.29.8",
		"@types/node": "^25.0.3",
		"markdownlint-cli2": "^0.22.1",
		"typescript": "^5.9.3",
		"vite": "^7.1.12",
		"vite-plugin-dts": "^4.5.4"
	},
	"pnpm": {
		"overrides": {
			"js-yaml": "3.14.2",
			"tar": "^7.5.2",
			"read-yaml-file>js-yaml": "3.14.2"
		}
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
