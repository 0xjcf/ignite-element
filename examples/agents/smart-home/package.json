{
	"name": "smart-home-agent-example",
	"version": "1.0.0",
	"description": "Drive a headless ignite-element smart home with Claude or a local MLX/OpenAI-compatible model via igniteTools, all in pure Node (no DOM).",
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"demo": "vite-node --script src/server.ts",
		"demo:mlx": "vite-node --script src/server-mlx.ts",
		"mock": "vite-node src/mock.ts",
		"mlx": "vite-node src/mlx.ts",
		"anthropic": "vite-node src/anthropic.ts",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"ignite-element",
		"igniteTools",
		"anthropic",
		"openai-compatible",
		"mlx",
		"tool-use",
		"agent",
		"headless",
		"smart-home",
		"xstate"
	],
	"license": "ISC",
	"dependencies": {
		"ws": "^8.18.3",
		"xstate": "5.32.1"
	},
	"devDependencies": {
		"@types/ws": "^8.18.1",
		"typescript": "^5.9.3",
		"vite": "^7.2.7",
		"vite-node": "^6.0.0",
		"vitest": "^4.0.3"
	}
}
