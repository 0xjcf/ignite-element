---
import { Aside } from "@astrojs/starlight/components";
import { routeUrl, versionDestination } from "../route-map.mjs";
const route = Astro.url.pathname
	.replace(/^\/ignite-element\/?/, "")
	.replace(/\/$/, "");
const archived = route === "2.x" || route.startsWith("2.x/");
---
{archived && (
  <Aside type="caution" title="Documentation version">
    You are reading the Ignite Element v2 docs. <a href={routeUrl(versionDestination(route, false))}>Read the v3 beta documentation</a>.
  </Aside>
)}
