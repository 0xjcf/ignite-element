		margin: 0;
		color: var(--sl-color-text-accent);
		font-size: 0.85rem;
	}

	.lede {
		color: var(--sl-color-text);
	}

	.snapshot,
	.log {
		margin: 0;
		padding: 0;
	}

	.snapshot {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.25rem 0.85rem;
		font-size: 0.85rem;
		font-family: var(--sl-font-mono, ui-monospace, monospace);
	}

	.snapshot :global(dt) {
		margin: 0;
		color: color-mix(in srgb, var(--sl-color-text) 68%, transparent);
	}

	.snapshot :global(dd) {
		margin: 0;
		font-variant-numeric: tabular-nums;
	}

	.log {
