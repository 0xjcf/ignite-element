<div
	class="smart-home-views not-content"
	aria-label="Live Smart Home views and effects explainer"
>
	<div class="explainer-grid">
		<ignite-views-home></ignite-views-home>
		<section class="observer" aria-labelledby="observer-heading">
			<p class="kicker">Effects notify · events declare · no live model</p>
			<h2 id="observer-heading">Observer</h2>
			<p class="lede">
				The panel is a view of <code>ctx</code>. Notices arrive from
				<code>core.on</code> and DOM <code>detail</code> after effects emit.
			</p>
			<ul class="declared" aria-label="Declared events"></ul>
			<p class="toast" role="status" data-empty="true">Waiting for an occurrence</p>
			<ol class="log" aria-live="polite"></ol>
		</section>
	</div>
	<noscript>Enable JavaScript to try the Smart Home.</noscript>
</div>

<script>
	import {
		connectHomeObserver,
		declaredEventNames,
		watchNotices,
	} from "../examples/smart-home-explainer/src/views-home";

	const root = document.querySelector(".smart-home-views");
	if (root) {
		const declared = root.querySelector(".declared");
		const toast = root.querySelector(".toast");
		const log = root.querySelector(".log");
		const host = root.querySelector("ignite-views-home");

		if (declared) {
			for (const name of declaredEventNames) {
				const item = document.createElement("li");
				item.textContent = name;
				declared.append(item);
			}
		}

		function paint(
			notices: readonly {
				origin: string;
				name: string;
				summary: string;
			}[],
			nextToast: { origin: string; name: string; summary: string } | null,
		) {
			if (toast instanceof HTMLElement) {
				if (nextToast) {
					toast.dataset.empty = "false";
					toast.dataset.name = nextToast.name;
					toast.textContent = nextToast.summary;
				} else {
					toast.dataset.empty = "true";
					delete toast.dataset.name;
					toast.textContent = "Waiting for an occurrence";
				}
			}
			if (!log) return;
			log.replaceChildren();
			for (const notice of notices) {
				const item = document.createElement("li");
				item.dataset.origin = notice.origin;
				item.dataset.name = notice.name;
				item.textContent = `${notice.origin} · ${notice.name}: ${notice.summary}`;
				log.append(item);
			}
		}

		watchNotices(paint);
		if (host) {
			connectHomeObserver(host);
		}
	}
</script>

