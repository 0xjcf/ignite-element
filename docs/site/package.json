{
	"name": "docs-site",
	"description": "Ignite Element v2 documentation (Astro + Starlight).",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check:contrast": "node scripts/check-contrast.mjs",
		"test:contrast": "astro build && node scripts/check-contrast.mjs",
		"check:docs": "node scripts/check-doc-examples.mjs",
		"check:astro": "astro check",
		"check:publication": "node --test scripts/check-docs-publication-permissions.test.mjs scripts/check-links.test.mjs && node scripts/check-docs-publication-contract.mjs",
		"check:links": "node scripts/check-links.mjs",
		"check:versions": "node scripts/check-version-routing.mjs",
		"check:versions:built": "node scripts/check-version-routing.mjs --built"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.39.3",
		"astro": "^6.4.3",
		"sharp": "^0.34.2",
		"starlight-versions": "^0.9.0"
	},
	"devDependencies": {
		"@actor-web/runtime": "0.2.1",
		"@astrojs/check": "0.9.10",
		"@playwright/test": "^1.56.1",
		"@reduxjs/toolkit": "2.12.0",
		"@testing-library/dom": "10.4.1",
		"remark-gfm": "^4.0.1",
		"starlight-llms-txt": "^0.10.0",
		"xstate": "5.32.1",
		"yaml": "2.9.0"
	}
}
